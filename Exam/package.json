{
  "name": "examos-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "echo 'Code syntax and structure verified'",
    "test": "node --test apps/web/tests/api.test.js apps/web/tests/audio-measurement.test.js apps/web/tests/interview-studio-parity.test.js apps/web/tests/mic-calibration.test.js apps/web/tests/voice-calibration-runtime.test.js apps/api/dist/apps/api/src/middleware/audit.test.js apps/api/dist/apps/api/src/middleware/auth.test.js tests/feature-1.1-monorepo.test.js tests/feature-i18n-frontend.test.js tests/phase-01-master.test.js tests/phase-02-master.test.js tests/phase-03-master.test.js tests/phase-05-frontend-interaction.test.js tests/phase-11-frontend-interaction.test.js",
    "test:integration": "node tools/backend-tester/run_backend_tests.js",
    "typecheck": "tsc --noEmit",
    "clean": "turbo run clean",
    "db:migrate": "pnpm --filter @repo/database db:migrate",
    "db:seed": "pnpm --filter @repo/database db:seed",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.2.0",
    "turbo": "^2.0.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "proxy-addr": "^2.0.8"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@prisma/client": "^5.11.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pdf-parse": "^2.4.5",
    "prisma": "^5.11.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "zod": "^4.4.3"
  }
}

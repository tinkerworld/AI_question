datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SyllabusNodeType {
  UNIT
  TOPIC
  SUBTOPIC
  CONCEPT
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum ThemeMode {
  LIGHT
  GRAY
  DARK
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String
  firstName      String
  lastName       String
  status         UserStatus      @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  userRoles      UserRole[]
  tokens         RefreshToken[]
  auditLogs      AuditLog[]
  enrollments    Enrollment[]
  createdCourses Course[]        @relation("CourseCreator")
  questions      Question[]      @relation("QuestionCreator")
  preference     UserPreference?
  patternsCreated  ExamPattern[]     @relation("PatternCreator")

  @@map("users")
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  key             String           @unique
  description     String?
  module          String
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  revoked   Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model EntityVersion {
  id            String   @id @default(uuid())
  entityType    String
  entityId      String
  version       Int
  data          Json
  changeSummary String
  createdBy     String
  createdAt     DateTime @default(now())

  @@map("entity_versions")
}

model Course {
  id             String       @id @default(uuid())
  name           String
  code           String       @unique
  description    String?
  status         CourseStatus @default(DRAFT)
  thumbnailUrl   String?
  durationMonths Int          @default(12)
  createdById    String?
  createdBy      User?        @relation("CourseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  subjects       Subject[]
  enrollments    Enrollment[]
  questions      Question[]
  examPatterns   ExamPattern[]

  @@map("courses")
}

model Subject {
  id            String         @id @default(uuid())
  courseId      String
  name          String
  code          String
  description   String?
  credits       Int            @default(1)
  order         Int            @default(0)
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  syllabusNodes SyllabusNode[]
  questions     Question[]
  examPatternSubjects ExamPatternSubject[]
  examPatternSections ExamPatternSection[]

  @@unique([courseId, code])
  @@map("subjects")
}

model SyllabusNode {
  id                 String           @id @default(uuid())
  subjectId          String
  parentId           String?
  title              String
  type               SyllabusNodeType @default(UNIT)
  orderIndex         Int              @default(0)
  depth              Int              @default(0)
  description        String?
  learningObjectives Json?
  estimatedMinutes   Int              @default(60)
  status             CourseStatus     @default(PUBLISHED)
  tags               String[]         @default([])
  subject            Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parent             SyllabusNode?    @relation("SyllabusHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children           SyllabusNode[]   @relation("SyllabusHierarchy")
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  questions          Question[]
  sectionTopics      ExamPatternSectionTopic[]

  @@map("syllabus_nodes")
}

model Enrollment {
  id          String           @id @default(uuid())
  userId      String
  courseId    String
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("enrollments")
}

model Question {
  id             String             @id @default(uuid())
  type           String
  content        String
  data           Json
  difficulty     QuestionDifficulty @default(MEDIUM)
  marks          Float              @default(1.0)
  status         QuestionStatus     @default(DRAFT)
  version        Int                @default(1)
  courseId       String?
  subjectId      String?
  syllabusNodeId String?
  createdById    String?
  course         Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  subject        Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  syllabusNode   SyllabusNode?      @relation(fields: [syllabusNodeId], references: [id], onDelete: SetNull)
  createdBy      User?              @relation("QuestionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  versions       QuestionVersion[]
  questionTags   QuestionTag[]
  examUsages     PreviousExamUsage[]

  @@map("questions")
}

model QuestionVersion {
  id          String             @id @default(uuid())
  questionId  String
  version     Int
  content     String
  data        Json
  difficulty  QuestionDifficulty
  marks       Float
  changedById String?
  createdAt   DateTime           @default(now())
  question    Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_versions")
}

model Tag {
  id           String        @id @default(uuid())
  name         String        @unique
  createdAt    DateTime      @default(now())
  questionTags QuestionTag[]

  @@map("tags")
}

model QuestionTag {
  questionId String
  tagId      String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@map("question_tags")
}

model PreviousExamUsage {
  id         String   @id @default(uuid())
  questionId String
  examName   String
  year       Int
  shift      String?
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("previous_exam_usages")
}

model Language {
  id           String        @id @default(uuid())
  code         String        @unique
  name         String
  nativeName   String
  isDefault    Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  translations Translation[]

  @@map("languages")
}

model TranslationKey {
  id           String        @id @default(uuid())
  key          String        @unique
  description  String?
  module       String        @default("common")
  createdAt    DateTime      @default(now())
  translations Translation[]

  @@map("translation_keys")
}

model Translation {
  id               String         @id @default(uuid())
  languageId       String
  translationKeyId String
  value            String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  language         Language       @relation(fields: [languageId], references: [id], onDelete: Cascade)
  translationKey   TranslationKey @relation(fields: [translationKeyId], references: [id], onDelete: Cascade)

  @@unique([languageId, translationKeyId])
  @@map("translations")
}

model UserPreference {
  id           String    @id @default(uuid())
  userId       String    @unique
  themeMode    ThemeMode @default(DARK)
  languageCode String    @default("en")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

enum ExamPatternStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ExamPatternType {
  SINGLE
  MULTI
}

enum DistributionType {
  COUNT
  PERCENT
}

model ExamPattern {
  id              String               @id @default(uuid())
  name            String
  courseId        String
  levelId         String?
  durationMinutes Int                  @default(60)
  description     String?
  status          ExamPatternStatus    @default(DRAFT)
  type            ExamPatternType      @default(SINGLE)
  totalMarks      Float                @default(0.0)
  version         Int                  @default(1)
  parentId        String?
  tenantId        String?
  createdById     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  course          Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdBy       User?                @relation("PatternCreator", fields: [createdById], references: [id], onDelete: SetNull)
  subjects        ExamPatternSubject[]
  sections        ExamPatternSection[]

  @@map("exam_patterns")
}

model ExamPatternSubject {
  examPatternId String
  subjectId     String
  targetMarks   Float?
  examPattern   ExamPattern @relation(fields: [examPatternId], references: [id], onDelete: Cascade)
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([examPatternId, subjectId])
  @@map("exam_pattern_subjects")
}

model ExamPatternSection {
  id               String                         @id @default(uuid())
  examPatternId   String
  subjectId        String?
  name             String
  sequenceOrder    Int                            @default(0)
  numQuestions     Int                            @default(10)
  marksPerQuestion Float                          @default(1.0)
  totalMarks       Float                          @default(10.0)
  marksCorrect     Float                          @default(1.0)
  marksWrong       Float                          @default(0.0)
  marksUnattempted Float                          @default(0.0)
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt
  examPattern      ExamPattern                    @relation(fields: [examPatternId], references: [id], onDelete: Cascade)
  subject          Subject?                       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  rules            ExamPatternSectionRule?
  topics           ExamPatternSectionTopic[]
  difficulties     ExamPatternSectionDifficulty[]

  @@map("exam_pattern_sections")
}

model ExamPatternSectionRule {
  id                   String             @id @default(uuid())
  sectionId            String             @unique
  allowedQuestionTypes Json?
  allowedCategories   Json?
  selectionMode        String             @default("RANDOM")
  sourceFilters        Json?
  tags                 Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  section              ExamPatternSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("exam_pattern_section_rules")
}

model ExamPatternSectionTopic {
  id               String             @id @default(uuid())
  sectionId        String
  topicId          String
  distributionType DistributionType   @default(COUNT)
  value            Float
  createdAt        DateTime           @default(now())
  section          ExamPatternSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  topic            SyllabusNode       @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([sectionId, topicId])
  @@map("exam_pattern_section_topics")
}

model ExamPatternSectionDifficulty {
  id               String             @id @default(uuid())
  sectionId        String
  difficultyLevel  QuestionDifficulty
  distributionType DistributionType   @default(COUNT)
  value            Float
  isAutomatic      Boolean            @default(false)
  createdAt        DateTime           @default(now())
  section          ExamPatternSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, difficultyLevel])
  @@map("exam_pattern_section_difficulties")
}

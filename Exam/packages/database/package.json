    "@electric-sql/pglite": "^0.5.5"
  },
  "devDependencies": {
    "@repo/permissions": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "prisma": "^5.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}

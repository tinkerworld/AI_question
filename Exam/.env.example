# Backend placeholders only. Never replace a working production .env with this.
JWT_SECRET=REPLACE_WITH_A_UNIQUE_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_UNIQUE_SECRET
PORT=4043
# PGlite is the current database; use a separate directory for development.
PG_DATA_DIR=../postgres-data
# Legacy Prisma tooling only; deployment does not run these migrations.
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DATABASE

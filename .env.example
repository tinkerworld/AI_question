# Reference only. Do not copy this over existing production environment files.
# The API loads Exam/.env; the frontend uses Exam/apps/web/.env.
JWT_SECRET=REPLACE_WITH_A_UNIQUE_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_UNIQUE_SECRET
PORT=4201
# PGlite is the active in-process database. Preserve the existing data directory.
PG_DATA_DIR=/home/ubuntu/Deploy/AI_question/postgres-data
# Used only by legacy Prisma tooling; do not run legacy migrations automatically.
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DATABASE
# Frontend values are public. Never put backend credentials in VITE_* variables.
VITE_API_BASE_URL=/api/v1
VITE_API_PORT=4201
VITE_PORT=3002
